# Copy to server/.env for local development (server/.env is git-ignored). Never commit real values.
DB_URL=jdbc:postgresql://localhost:5432/partner_erp
DB_USERNAME=postgres
DB_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173
SERVER_PORT=8080
# HS256 signing key for access tokens, at least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value
# One-time Super Admin bootstrap (only used while no Super Admin exists). Remove after first login.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_NAME=Super Admin
